{
  "name": "moveka",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm prisma:generate && pnpm prisma:migrate:deploy && pnpm db:seed && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js validate",
    "prisma:migrate:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx prisma/seed.ts",
    "test:db-smoke": "node --env-file-if-exists=.env.local --import tsx prisma/smoke.ts",
    "test:db-integration": "node --env-file-if-exists=.env.local --import tsx prisma/integration.ts",
    "test:db-workspace": "node --env-file-if-exists=.env.local --import tsx prisma/workspace-integration.ts",
    "verify": "pnpm prisma:generate && pnpm prisma:validate && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^16.1.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.0",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
