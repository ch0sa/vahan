# PostgreSQL orchestration store. This prototype has no live government, identity, or payment connection.
DATABASE_URL="postgresql://moveka:moveka@localhost:5432/moveka?schema=public"
DEMO_MODE="true"
# Local-only shared password for the two synthetic citizen accounts. Defaults to "admin" only while DEMO_MODE=true.
DEMO_SHARED_PASSWORD="admin"
# Base64-encoded, random 32-byte key. Retained only for the separate legacy operator enrollment path.
TOTP_ENCRYPTION_KEY=""
# Base64-encoded, random 32-byte server-only key used to HMAC opaque session tokens.
SESSION_HASH_KEY=""
# Base64-encoded random 32-byte local-only token required once to bootstrap the synthetic DEMO_OPERATOR.
DEMO_OPERATOR_BOOTSTRAP_TOKEN=""
